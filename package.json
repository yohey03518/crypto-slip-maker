{
  "name": "crypto-slip-maker-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo workspace for crypto slip maker apps",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
